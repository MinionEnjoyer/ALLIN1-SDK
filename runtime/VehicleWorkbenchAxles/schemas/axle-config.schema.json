{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allin1.local/schemas/vehicle-workbench-axles/v4.json",
  "title": "Vehicle Workbench axle configuration",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "canonicalWheelPair": {
      "oneOf": [
        { "const": ["wheel_lf", "wheel_rf"] },
        { "const": ["wheel_lm1", "wheel_rm1"] },
        { "const": ["wheel_lm2", "wheel_rm2"] },
        { "const": ["wheel_lm3", "wheel_rm3"] },
        { "const": ["wheel_lr", "wheel_rr"] }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "configurationId",
    "modelName",
    "modelHash",
    "expectedWheelCount",
    "minimumRuntimeVersion",
    "axles",
    "compatibility"
  ],
  "dependentSchemas": {
    "intentionalLayoutOverride": {
      "oneOf": [
        {
          "properties": {
            "axles": { "minItems": 2, "maxItems": 2 },
            "intentionalLayoutOverride": {
              "properties": {
                "physicalBonePairs": { "minItems": 2, "maxItems": 2 }
              }
            }
          }
        },
        {
          "properties": {
            "axles": { "minItems": 3, "maxItems": 3 },
            "intentionalLayoutOverride": {
              "properties": {
                "physicalBonePairs": { "minItems": 3, "maxItems": 3 }
              }
            }
          }
        },
        {
          "properties": {
            "axles": { "minItems": 4, "maxItems": 4 },
            "intentionalLayoutOverride": {
              "properties": {
                "physicalBonePairs": { "minItems": 4, "maxItems": 4 }
              }
            }
          }
        },
        {
          "properties": {
            "axles": { "minItems": 5, "maxItems": 5 },
            "intentionalLayoutOverride": {
              "properties": {
                "physicalBonePairs": { "minItems": 5, "maxItems": 5 }
              }
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    { "required": ["wheelIndexMap"] },
    { "required": ["wheelIndexMapping"] }
  ],
  "allOf": [
    {
      "if": {
        "required": ["schemaVersion"],
        "properties": { "schemaVersion": { "const": 1 } }
      },
      "then": {
        "not": { "required": ["steeringCalculation"] },
        "properties": {
          "axles": {
            "items": {
              "allOf": [
                { "not": { "required": ["suspension"] } },
                {
                  "if": {
                    "required": ["steered"],
                    "properties": { "steered": { "const": true } }
                  },
                  "then": {
                    "properties": {
                      "steeringGain": {
                        "minimum": 0.999999999,
                        "maximum": 1.0
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": ["steered"],
                    "properties": { "steered": { "const": false } }
                  },
                  "then": {
                    "properties": {
                      "steeringGain": {
                        "minimum": -1e-9,
                        "maximum": 1e-9
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["schemaVersion"],
        "properties": { "schemaVersion": { "const": 2 } }
      },
      "then": {
        "required": ["steeringCalculation"],
        "properties": {
          "minimumRuntimeVersion": {
            "type": "string",
            "pattern": "^(?:[2-9]|[1-9][0-9]+)\\.[0-9]+\\.[0-9]+$"
          },
          "axles": {
            "items": {
              "required": ["steeringGain"],
              "not": { "required": ["suspension"] }
            },
            "contains": {
              "type": "object",
              "required": ["steered", "steeringGain"],
              "properties": {
                "steered": { "const": true },
                "steeringGain": {
                  "not": {
                    "minimum": 0.999999999,
                    "maximum": 1.0
                  }
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "required": ["schemaVersion"],
        "properties": { "schemaVersion": { "const": 3 } }
      },
      "then": {
        "allOf": [
          {
            "if": {
              "properties": {
                "axles": {
                  "contains": {
                    "type": "object",
                    "required": ["steered", "steeringGain"],
                    "properties": {
                      "steered": { "const": true },
                      "steeringGain": {
                        "not": {
                          "minimum": 0.999999999,
                          "maximum": 1.0
                        }
                      }
                    }
                  },
                  "minContains": 1
                }
              }
            },
            "then": { "required": ["steeringCalculation"] },
            "else": { "not": { "required": ["steeringCalculation"] } }
          }
        ],
        "properties": {
          "minimumRuntimeVersion": {
            "type": "string",
            "pattern": "^(?:[3-9]|[1-9][0-9]+)\\.[0-9]+\\.[0-9]+$"
          },
          "axles": {
            "items": { "required": ["steeringGain", "suspension"] }
          }
        }
      }
    },
    {
      "if": {
        "required": ["schemaVersion"],
        "properties": { "schemaVersion": { "const": 4 } }
      },
      "then": {
        "required": ["steeringCommandPolarity"],
        "allOf": [
          {
            "if": {
              "properties": {
                "axles": {
                  "contains": {
                    "type": "object",
                    "required": ["steered", "steeringGain"],
                    "properties": {
                      "steered": { "const": true },
                      "steeringGain": {
                        "not": { "minimum": 0.999999999, "maximum": 1.0 }
                      }
                    }
                  },
                  "minContains": 1
                }
              }
            },
            "then": { "required": ["steeringCalculation"] },
            "else": { "not": { "required": ["steeringCalculation"] } }
          },
          {
            "if": {
              "properties": {
                "axles": { "contains": { "required": ["suspension"] } }
              }
            },
            "then": {
              "properties": {
                "axles": { "items": { "required": ["suspension"] } }
              }
            }
          }
        ],
        "properties": {
          "steeringCommandPolarity": { "const": "inverted" },
          "minimumRuntimeVersion": {
            "type": "string",
            "pattern": "^(?:[4-9]|[1-9][0-9]+)\\.[0-9]+\\.[0-9]+$"
          },
          "axles": { "items": { "required": ["steeringGain"] } }
        }
      }
    },
    {
      "if": {
        "required": ["steeringCommandPolarity"],
        "properties": { "steeringCommandPolarity": { "const": "inverted" } }
      },
      "then": {
        "properties": { "schemaVersion": { "const": 4 } }
      }
    },
    {
      "if": {
        "required": ["steeringCalculation"],
        "properties": {
          "steeringCalculation": { "required": ["physicalBonePairs"] }
        }
      },
      "then": { "required": ["intentionalLayoutOverride"] }
    },
    {
      "if": {
        "required": ["intentionalLayoutOverride", "steeringCalculation"]
      },
      "then": {
        "properties": {
          "steeringCalculation": { "required": ["physicalBonePairs"] }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1, 2, 3, 4] },
    "configurationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "modelName": { "type": "string", "minLength": 1, "maxLength": 128 },
    "modelHash": { "type": ["string", "integer"] },
    "expectedWheelCount": { "type": "integer", "enum": [4, 6, 8, 10] },
    "minimumRuntimeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "steeringCommandPolarity": {
      "type": "string",
      "enum": ["normal", "inverted"],
      "default": "normal",
      "description": "Vehicle-level command polarity. Runtime computes effective steering gain as the authored base steeringGain multiplied once by +1 for normal or -1 for inverted."
    },
    "wheelIndexMap": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 10,
      "propertyNames": {
        "enum": [
          "wheel_lf", "wheel_rf", "wheel_lm1", "wheel_rm1",
          "wheel_lm2", "wheel_rm2", "wheel_lm3", "wheel_rm3",
          "wheel_lr", "wheel_rr"
        ]
      },
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 9 }
    },
    "wheelIndexMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reported_wheel_count", "by_bone"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "reported_wheel_count": { "type": "integer", "enum": [4, 6, 8, 10] },
        "by_bone": {
          "type": "object",
          "minProperties": 4,
          "maxProperties": 10,
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 9 }
        }
      }
    },
    "axles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "role", "leftBone", "rightBone", "steered", "powered"],
        "allOf": [
          {
            "if": {
              "required": ["steered"],
              "properties": { "steered": { "const": false } }
            },
            "then": {
              "properties": {
                "steeringGain": {
                  "minimum": -1e-9,
                  "maximum": 1e-9
                }
              }
            }
          }
        ],
        "properties": {
          "order": { "type": "integer", "minimum": 0, "maximum": 4 },
          "role": { "type": "string", "enum": ["front", "middle", "rear", "tag"] },
          "leftBone": { "type": "string" },
          "rightBone": { "type": "string" },
          "wheelIndices": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 0, "maximum": 9 }
          },
          "steered": { "type": "boolean" },
          "steeringGain": {
            "type": "number",
            "minimum": -1.0,
            "maximum": 1.0,
            "description": "Optional signed phase/gain. Omit for legacy boolean steering; non-steered axles must use 0."
          },
          "powered": { "type": "boolean" },
          "suspension": {
            "type": "object",
            "additionalProperties": false,
            "required": ["supportWeight"],
            "properties": {
              "supportWeight": {
                "type": "number",
                "minimum": 0.75,
                "maximum": 1.25,
                "description": "Relative axle support bias; runtime normalizes all physical axles to the vehicle's original total StaticForce."
              }
            }
          },
          "serviceBrake": { "type": "boolean" },
          "handbrake": { "type": "boolean" },
          "visualFamily": { "type": "string" }
        }
      }
    },
    "handling": { "type": "object" },
    "dualTyreGeometry": { "type": "array", "items": { "type": "string" } },
    "dualTyresConsumePhysicalSlots": { "const": false },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storyLegacy": { "type": "boolean" },
        "storyEnhanced": { "type": "boolean" },
        "story-legacy": { "type": "boolean" },
        "story-enhanced": { "type": "boolean" }
      },
      "anyOf": [
        {
          "required": ["storyLegacy"],
          "properties": { "storyLegacy": { "const": true } }
        },
        {
          "required": ["storyEnhanced"],
          "properties": { "storyEnhanced": { "const": true } }
        },
        {
          "required": ["story-legacy"],
          "properties": { "story-legacy": { "const": true } }
        },
        {
          "required": ["story-enhanced"],
          "properties": { "story-enhanced": { "const": true } }
        }
      ]
    },
    "steeringCalculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "algorithmVersion", "bonePositionSha256"],
      "properties": {
        "mode": { "type": "string", "enum": ["automaticGeometry", "manual"] },
        "algorithmVersion": { "const": 1 },
        "bonePositionSha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "runtimeRecompute": {
          "type": "boolean",
          "default": false,
          "description": "Recalculate automatic steering gains from authoritative vehicle-local wheel positions at runtime."
        },
        "referenceSelection": {
          "type": "string",
          "enum": ["farthest_steered_axle"]
        },
        "pivotLongitudinalPosition": { "type": "number" },
        "pivotSource": {
          "type": "string",
          "enum": ["explicit", "selected_fixed_axles", "derived_fixed_axles"]
        },
        "pivotAxleOrders": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 4 }
        },
        "referenceAxleOrder": { "type": "integer", "minimum": 0, "maximum": 4 },
        "referenceLockDegrees": { "type": "number", "minimum": 1, "maximum": 80 },
        "pairPositionTolerance": { "type": "number", "exclusiveMinimum": 0 },
        "positionEpsilon": { "type": "number", "exclusiveMinimum": 0 },
        "physicalBonePairs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalWheelPair" }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["mode"],
            "properties": { "mode": { "const": "automaticGeometry" } }
          },
          "then": {
            "required": [
              "pivotLongitudinalPosition", "pivotSource",
              "pivotAxleOrders", "referenceAxleOrder", "referenceLockDegrees",
              "pairPositionTolerance", "positionEpsilon"
            ]
          }
        },
        {
          "if": {
            "required": ["runtimeRecompute"],
            "properties": { "runtimeRecompute": { "const": true } }
          },
          "then": {
            "required": ["referenceSelection"]
          },
          "else": {
            "not": { "required": ["referenceSelection"] }
          }
        },
        {
          "if": {
            "required": ["mode"],
            "properties": { "mode": { "const": "manual" } }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["pivotLongitudinalPosition"] },
                { "required": ["pivotSource"] },
                { "required": ["pivotAxleOrders"] },
                { "required": ["referenceAxleOrder"] },
                { "required": ["referenceLockDegrees"] },
                { "required": ["pairPositionTolerance"] },
                { "required": ["positionEpsilon"] },
                { "required": ["referenceSelection"] }
              ]
            }
          }
        }
      ]
    },
    "intentionalLayoutOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "physicalBonePairs",
        "bonePositionSha256",
        "reason"
      ],
      "properties": {
        "mode": { "const": "visual_instancing_remap" },
        "physicalBonePairs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalWheelPair" }
        },
        "bonePositionSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240,
          "pattern": "^[^\\r\\n]{8,240}$"
        }
      }
    }
  }
}
