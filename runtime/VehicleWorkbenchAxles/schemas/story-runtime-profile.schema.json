{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allin1.local/schemas/vehicle-workbench-axles/story-runtime-profile-v1.json",
  "title": "Vehicle Workbench Story runtime profile",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "properties": {
              "static_force": { "const": true },
              "physics_activation": { "const": true }
            }
          }
        }
      },
      "then": {
        "required": ["maximum_axle_schema"],
        "properties": { "maximum_axle_schema": { "minimum": 3 } }
      }
    },
    {
      "if": {
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "properties": { "signed_steering_gain": { "const": true } }
          }
        }
      },
      "then": {
        "required": ["maximum_axle_schema"],
        "properties": { "maximum_axle_schema": { "minimum": 2 } }
      }
    },
    {
      "if": {
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "required": ["wheel_local_position"],
            "properties": { "wheel_local_position": { "const": true } }
          }
        }
      },
      "then": {
        "required": ["maximum_axle_schema"],
        "properties": { "maximum_axle_schema": { "minimum": 2 } }
      }
    }
  ],
  "required": [
    "profile_id",
    "target_id",
    "binary_path",
    "version",
    "supported_game_builds",
    "expected_sha256",
    "package_eligible",
    "validation_receipt_path",
    "expected_receipt_sha256",
    "redistribution_allowed",
    "license"
  ],
  "properties": {
    "profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "target_id": { "enum": ["story-legacy", "story-enhanced"] },
    "binary_path": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "supported_game_builds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 96 }
    },
    "expected_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "package_eligible": { "const": true },
    "validation_receipt_path": { "type": "string", "minLength": 1 },
    "expected_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "maximum_axle_schema": { "type": "integer", "minimum": 1, "default": 1 },
    "capabilities": {
      "type": "object",
      "default": {
        "signed_steering_gain": false,
        "static_force": false,
        "physics_activation": false,
        "wheel_local_position": false
      },
      "additionalProperties": false,
      "required": [
        "signed_steering_gain", "static_force", "physics_activation"
      ],
      "properties": {
        "signed_steering_gain": { "type": "boolean" },
        "static_force": { "type": "boolean" },
        "physics_activation": { "type": "boolean" },
        "wheel_local_position": {
          "type": "boolean",
          "default": false,
          "description": "The exact-build adapter can safely read authoritative vehicle-local physical wheel positions."
        }
      }
    },
    "redistribution_allowed": { "const": true },
    "license": { "type": "string", "minLength": 1 }
  }
}
