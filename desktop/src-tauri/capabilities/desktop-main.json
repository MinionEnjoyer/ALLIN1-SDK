{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-main",
  "description": "Least-privilege capability for the bundled ALLIN1 main WebView.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "allow-desktop-frontend-ready", "allow-desktop-close",
    "allow-desktop-apply-rpf-change-set", "allow-select-rpf-plan-destination",
    "allow-desktop-apply-rpf-transaction",
    "allow-desktop-apply-rpf-utility", "allow-select-rpf-utility-destination",
    "allow-desktop-apply-workspace-action",
    "allow-desktop-apply-gxt2-action", "allow-select-gxt2-build-destination",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-desktop-handshake",
    "allow-desktop-catalog",
    "allow-desktop-execute",
    "allow-desktop-configure-assistant",
    "allow-desktop-apply-weapon-authoring",
    "allow-desktop-apply-ped-authoring",
    "allow-desktop-prepare-vehicle-quick-import",
    "allow-desktop-apply-vehicle-oiv-export",
    "allow-desktop-apply-vehicle-package-publish",
    "allow-desktop-apply-package-lifecycle",
    "allow-desktop-render-vehicle-model",
    "allow-desktop-vehicle-authoring-action",
    "allow-desktop-model-material-authoring-action",
    "allow-desktop-texture-authoring-action",
    "allow-desktop-start-job",
    "allow-desktop-cancel-job",
    "allow-desktop-check-update",
    "allow-select-path",
    "allow-select-report-destination",
    "allow-select-oiv-destination",
    "allow-select-package-zip-destination",
    "allow-select-model-build-destination",
    "allow-select-texture-build-destination",
    "allow-initial-launch-request",
    "allow-restart-sidecar"
  ]
}
