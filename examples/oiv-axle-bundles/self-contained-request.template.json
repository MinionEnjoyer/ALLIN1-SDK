{
  "staging_root": "<STORY_STAGING_ROOT>",
  "target": "story-legacy",
  "mode": "self-contained",
  "metadata": {
    "project_id": "com.example.mybus-project",
    "package_id": "com.example.mybus.self-contained",
    "name": "My Bus — Self-Contained",
    "version": "1.0.0",
    "author": "<AUTHOR>",
    "description": "Installs My Bus and a validated shared axle runtime.",
    "workbench_version": "0.6.0"
  },
  "vehicle_dlcs": [
    {
      "dlc_pack_name": "vwb_mybus",
      "archive_path": "vehicle-package/payload/dlc.rpf",
      "vehicle_models": ["mybus"],
      "asset_edition": "legacy"
    }
  ],
  "axle_configurations": [
    {
      "model_name": "mybus",
      "model_hash": "<JOAAT_HEX>",
      "source_path": "configs/mybus.json",
      "schema_version": 1,
      "minimum_runtime_version": "1.0.0"
    }
  ],
  "runtime": {
    "profile_path": "<VALIDATED_STORY_RUNTIME_PROFILE_JSON>",
    "build_date": "<BUILD_DATE>",
    "required_scripthook_version": "<COMPATIBILITY_RANGE>"
  },
  "include_documentation": true,
  "confirm_self_contained": true,
  "compression": "deflated"
}
