{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allin1.local/sdk/addon.schema.json",
  "title": "ALLIN1 Add-on Content Integration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "editions", "nodes", "references", "install_steps"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "editions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["legacy", "enhanced"]}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "fields"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
          "kind": {"enum": ["weapon", "weapon_component", "ammo", "animation", "text_label", "hud_alias", "runtime", "storefront", "vehicle", "handling", "vehicle_variation", "tuning", "ped", "streaming", "dlc_registration", "script_plugin", "asi_plugin", "reshade_addon", "replacement", "archive", "package"]},
          "label": {"type": "string"},
          "description": {"type": "string"},
          "source": {"type": "string", "minLength": 1},
          "fields": {"type": "object"}
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "source_field", "target", "target_field", "relationship"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
          "source": {"type": "string"},
          "source_field": {"type": "string"},
          "target": {"type": "string"},
          "target_field": {"type": "string"},
          "relationship": {"type": "string"},
          "description": {"type": "string"},
          "required": {"type": "boolean", "default": true}
        }
      }
    },
    "install_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "title", "target", "strategy"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
          "order": {"type": "integer"},
          "title": {"type": "string"},
          "target": {"type": "string"},
          "strategy": {"type": "string"},
          "source": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    }
  }
}
