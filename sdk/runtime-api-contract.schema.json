{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allin1.dev/schemas/runtime-api-contract.schema.json",
  "title": "ALLIN1 Runtime API Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "api_version",
    "assembly",
    "public_type",
    "source",
    "symbols"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "api_version": {"type": "integer", "minimum": 1},
    "assembly": {
      "type": "string",
      "pattern": "^scripts/(?!.*(?:^|/)\\.\\.?/).+\\.dll$"
    },
    "public_type": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$"
    },
    "source": {"type": "string", "pattern": "^[^/].+\\.cs$"},
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/symbol"}
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": {"type": "string", "minLength": 1, "maxLength": 160},
        "optional": {"type": "boolean"},
        "default": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"optional": {"const": true}},
            "required": ["optional"]
          },
          "then": {"required": ["default"]},
          "else": {"not": {"required": ["default"]}}
        }
      ]
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "kind": {
          "enum": ["constant", "property", "method", "interface", "type"]
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,95}$"
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "return_type": {"type": "string", "minLength": 1, "maxLength": 160},
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/$defs/parameter"}
        },
        "value": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "method"}},
            "required": ["kind"]
          },
          "then": {"required": ["return_type", "parameters"]},
          "else": {"not": {"required": ["parameters"]}}
        },
        {
          "if": {
            "properties": {"kind": {"enum": ["constant", "property"]}},
            "required": ["kind"]
          },
          "then": {"required": ["return_type"]},
          "else": {
            "if": {
              "properties": {"kind": {"const": "method"}},
              "required": ["kind"]
            },
            "else": {"not": {"required": ["return_type"]}}
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "constant"}},
            "required": ["kind"]
          },
          "then": {"required": ["value"]},
          "else": {"not": {"required": ["value"]}}
        }
      ]
    }
  }
}
