{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allin1.dev/schemas/map-project.schema.json",
  "title": "ALLIN1 Map Project",
  "description": "Declarative streamed-map, level, portal, and Story-save garage contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "package_id",
    "name",
    "version",
    "editions",
    "streaming",
    "levels",
    "portals"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/identifier"},
    "package_id": {"$ref": "#/$defs/identifier"},
    "name": {"$ref": "#/$defs/displayName"},
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,31}$"
    },
    "editions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["legacy", "enhanced"]}
    },
    "streaming": {"$ref": "#/$defs/streaming"},
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/level"}
    },
    "portals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/portal"}
    },
    "garages": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/garage"},
      "default": []
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^(?!world$)[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "levelReference": {
      "type": "string",
      "pattern": "^(?:world|[a-z0-9][a-z0-9._-]{1,63})$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "nativeName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_:.@-]{1,96}$"
    },
    "nativeNames": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nativeName"}
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38},
        "y": {"type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38},
        "z": {"type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38},
        "heading": {"type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38, "default": 0.0}
      }
    },
    "streaming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_name"],
      "properties": {
        "pack_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "content_group": {
          "oneOf": [
            {"$ref": "#/$defs/nativeName"},
            {"type": "null"}
          ]
        },
        "ipls": {
          "$ref": "#/$defs/nativeNames",
          "default": []
        },
        "activation_radius": {
          "type": "number",
          "minimum": 10.0,
          "maximum": 10000.0,
          "default": 300.0
        },
        "release_radius": {
          "type": "number",
          "minimum": 10.0,
          "maximum": 20000.0,
          "default": 500.0
        },
        "keep_resident": {"type": "boolean", "default": false}
      },
      "anyOf": [
        {
          "required": ["content_group"],
          "properties": {"content_group": {"$ref": "#/$defs/nativeName"}}
        },
        {
          "required": ["ipls"],
          "properties": {"ipls": {"minItems": 1}}
        }
      ],
      "$comment": "MapProject.load additionally requires release_radius >= activation_radius, rejects IPL duplicates case-insensitively, and requires at least one project-level or level-level IPL because the Story runtime never executes arbitrary content groups."
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "center"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/displayName"},
        "center": {"$ref": "#/$defs/position"},
        "ipls": {"$ref": "#/$defs/nativeNames", "default": []}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "position"],
      "properties": {
        "level": {"$ref": "#/$defs/levelReference"},
        "position": {"$ref": "#/$defs/position"}
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "from", "to"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/displayName"},
        "mode": {"enum": ["ped", "vehicle", "both"]},
        "from": {"$ref": "#/$defs/endpoint"},
        "to": {"$ref": "#/$defs/endpoint"},
        "radius": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 50.0,
          "default": 3.0
        },
        "one_way": {"type": "boolean", "default": false}
      },
      "$comment": "MapProject.load requires the endpoints to reference known, different levels."
    },
    "vehicleTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["land", "helicopter", "plane", "boat"]}
    },
    "garageRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_store": {"type": "boolean", "default": true},
        "allow_retrieve": {"type": "boolean", "default": true},
        "save_policy": {"const": "story_save_only", "default": "story_save_only"}
      },
      "not": {
        "required": ["allow_store", "allow_retrieve"],
        "properties": {
          "allow_store": {"const": false},
          "allow_retrieve": {"const": false}
        }
      }
    },
    "garageSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "position": {"$ref": "#/$defs/position"},
        "vehicle_types": {"$ref": "#/$defs/vehicleTypes"}
      },
      "$comment": "MapProject.load requires an explicit slot vehicle_types array to be a subset of the garage vehicle_types array."
    },
    "garage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "level_id",
        "entrance_portal_id",
        "capacity",
        "vehicle_types",
        "slots"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/displayName"},
        "level_id": {"$ref": "#/$defs/levelReference"},
        "entrance_portal_id": {"$ref": "#/$defs/identifier"},
        "capacity": {"type": "integer", "minimum": 1, "maximum": 100},
        "vehicle_types": {"$ref": "#/$defs/vehicleTypes"},
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/garageSlot"}
        },
        "rules": {"$ref": "#/$defs/garageRules", "default": {}}
      },
      "$comment": "MapProject.load resolves level/portal references, checks unique IDs, and requires capacity >= slot count."
    }
  },
  "$comment": "MapProject.load is authoritative for normalized text, case-insensitive uniqueness, cross-object references, and other relationships JSON Schema cannot express portably."
}
